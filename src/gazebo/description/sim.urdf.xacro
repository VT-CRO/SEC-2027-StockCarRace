<?xml version="1.0" ?>

<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    
    <xacro:property name="chassis_x" value="0.5"/>
    <xacro:property name="chassis_y" value="0"/>
    <xacro:property name="chassis_z" value="0.4"/>

    <xacro:property name="chassis_length" value="2.0"/>
    <xacro:property name="chassis_width" value="1.0"/>
    <xacro:property name="chassis_height" value="0.5"/>
    <xacro:property name="chassis_mass" value="1.14395"/>
    <xacro:property name="chassis_ixx" value="0.095329"/>
    <xacro:property name="chassis_ixy" value="0"/>
    <xacro:property name="chassis_ixz" value="0"/>
    <xacro:property name="chassis_iyy" value="0.381317"/>
    <xacro:property name="chassis_iyz" value="0"/>
    <xacro:property name="chassis_izz" value="0.476646"/>

    <xacro:property name="wheel_x" value="-0.5"/>
    <xacro:property name="wheel_y" value="0.6"/>
    <xacro:property name="wheel_z" value="0"/>
    <xacro:property name="wheel_roll" value="-1.5707"/>
    <xacro:property name="wheel_mass" value="1"/>
    <xacro:property name="wheel_radius" value="0.4"/>
    <xacro:property name="wheel_width" value="0.2"/>
    <xacro:property name="wheel_ixx" value="0.043333"/>
    <xacro:property name="wheel_ixy" value="0"/>
    <xacro:property name="wheel_ixz" value="0"/>
    <xacro:property name="wheel_iyy" value="0.043333"/>
    <xacro:property name="wheel_iyz" value="0"/>
    <xacro:property name="wheel_izz" value="0.08"/>
    <xacro:property name="wheel_separation" value="1.2"/>

    <xacro:property name="caster_x" value="0.8"/>
    <xacro:property name="caster_y" value="0"/>
    <xacro:property name="caster_z" value="-0.2"/>
    <xacro:property name="caster_mass" value="1"/>
    <xacro:property name="caster_radius" value="0.2"/>
    <xacro:property name="caster_ixx" value="0.016"/>
    <xacro:property name="caster_ixy" value="0"/>
    <xacro:property name="caster_ixz" value="0"/>
    <xacro:property name="caster_iyy" value="0.016"/>
    <xacro:property name="caster_iyz" value="0"/>
    <xacro:property name="caster_izz" value="0.016"/>

    <world name="car_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <!-- Standard Earth gravity: 9.8 m/s^2 down along the Z-axis -->
        <gravity>0 0 -9.8</gravity>

        <!-- Plugin for physics, user commands, and scene broadcasting -->
        <plugin
            filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics">
        </plugin>
        <plugin
            filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands">
        </plugin>
        <plugin
            filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster">
        </plugin>

        <!--Topics-->
        <!-- <topic>/cmd_vel</topic> -->

        <!-- Include additional models or plugins here -->
        

        <!-- Robot definition-->
        <model name="robot">
            
            <!-- Define the robot's links, joints, and sensors here -->
            <link name='chassis'>

                <pose relative_to='__model__'>${chassis_x} ${chassis_y} ${chassis_z} 0 0 0</pose> <!-- Define this to be the COG of the robot-->

                <inertial>
                    <mass>${chassis_mass}</mass> <!-- MASS of the CHASSIS -->
                    <inertia>
                        <!-- Use this to calculate for real robot: 
                        https://amesweb.info/inertia/mass-moment-of-inertia-calculator.aspx-->
                        <ixx>${chassis_ixx}</ixx>
                        <ixy>${chassis_ixy}</ixy>
                        <ixz>${chassis_ixz}</ixz>
                        <iyy>${chassis_iyy}</iyy>
                        <iyz>${chassis_iyz}</iyz>
                        <izz>${chassis_izz}</izz>
                    </inertia>
                </inertial>

                 <!-- VISUALS AND COLLISION BOXES -->
                <visual name='visual'>
                    <geometry>
                        <box>
                            <!-- the DIMENSIONS of the ROBOT -->
                            <size>${chassis_length} ${chassis_width} ${chassis_height}</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <!-- the DIMENSIONS of the ROBOT -->
                            <size>${chassis_length} ${chassis_width} ${chassis_height}</size>
                        </box>
                    </geometry>
                </collision>
            </link>

            <link name='right_wheel'>
            
                <pose relative_to="chassis">${wheel_x} -${wheel_y} ${wheel_z} ${wheel_roll} 0 0</pose> <!--angles are in radian-->
                <inertial>
                    <mass>${wheel_mass}</mass>
                    <inertia>
                    <!-- Use this to calculate for real robot: 
                        https://amesweb.info/inertia/mass-moment-of-inertia-calculator.aspx-->
                        <ixx>${wheel_ixx}</ixx>
                        <ixy>${wheel_ixy}</ixy>
                        <ixz>${wheel_ixz}</ixz>
                        <iyy>${wheel_iyy}</iyy>
                        <iyz>${wheel_iyz}</iyz>
                        <izz>${wheel_izz}</izz>
                        </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>${wheel_radius}</radius> <!-- the RADIUS of the WHEEL -->
                            <length>${wheel_width}</length> <!-- the HEIGHT/WIDTH of the WHEEL -->
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material> 
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>${wheel_radius}</radius> <!-- the RADIUS of the WHEEL -->
                            <length>${wheel_width}</length> <!-- the HEIGHT/WIDTH of the WHEEL -->
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <link name='left_wheel'>
                <pose relative_to="chassis">${wheel_x} ${wheel_y} ${wheel_z} ${wheel_roll} 0 0</pose>
                <inertial>
                    <mass>${wheel_mass}</mass>
                    <inertia>
                    <!-- Use this to calculate for real robot: 
                        https://amesweb.info/inertia/mass-moment-of-inertia-calculator.aspx-->
                        <ixx>${wheel_ixx}</ixx>
                        <ixy>${wheel_ixy}</ixy>
                        <ixz>${wheel_ixz}</ixz>
                        <iyy>${wheel_iyy}</iyy>
                        <iyz>${wheel_iyz}</iyz>
                        <izz>${wheel_izz}</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>${wheel_radius}</radius> <!-- the RADIUS of the WHEEL -->
                            <length>${wheel_width}</length> <!-- the HEIGHT/WIDTH of the WHEEL -->
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material> 
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>${wheel_radius}</radius> <!-- the RADIUS of the WHEEL -->
                            <length>${wheel_width}</length> <!-- the HEIGHT/WIDTH of the WHEEL -->
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <frame name="caster_frame" attached_to='chassis'>
                <pose>${caster_x} ${caster_y} ${caster_z} 0 0 0</pose> <!-- Define the position and orientation of the caster frame relative to the chassis -->
            </frame>
            <link name='caster'>
                <pose relative_to='caster_frame'/>
                <inertial>
                    <mass>${caster_mass}</mass>
                    <inertia>
                        <ixx>${caster_ixx}</ixx>
                        <ixy>${caster_ixy}</ixy>
                        <ixz>${caster_ixz}</ixz>
                        <iyy>${caster_iyy}</iyy>
                        <iyz>${caster_iyz}</iyz>
                        <izz>${caster_izz}</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>${caster_radius}</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <sphere>
                            <radius>${caster_radius}</radius>
                        </sphere>
                    </geometry>
                </collision>
            </link>


            <joint name='left_wheel_joint' type='revolute'>
                    <pose relative_to='left_wheel'/>
                    <parent>chassis</parent>
                    <child>left_wheel</child>
                    <axis>
                    <xyz expressed_in='__model__'>0 1 0</xyz> <!--can be defined as any frame or even arbitrary frames-->
                    <limit>
                        <lower>-1.79769e+308</lower>    <!--negative infinity-->
                        <upper>1.79769e+308</upper>     <!--positive infinity-->
                    </limit>
                </axis>
            </joint>
            <joint name='right_wheel_joint' type='revolute'>
                    <pose relative_to='right_wheel'/>
                    <parent>chassis</parent>
                    <child>right_wheel</child>
                    <axis>
                    <xyz expressed_in='__model__'>0 1 0</xyz> <!--can be defined as any frame or even arbitrary frames-->
                    <limit>
                        <lower>-1.79769e+308</lower>    <!--negative infinity-->
                        <upper>1.79769e+308</upper>     <!--positive infinity-->
                    </limit>
                </axis>
            </joint>

            <joint name='caster_wheel' type='ball'>
                <pose relative_to='caster_frame'/>
                <parent>chassis</parent>
                <child>caster</child>
            </joint>


            <plugin
                filename="libignition-gazebo-diff-drive-system.so"
                name="ignition::gazebo::systems::DiffDrive">
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>
                <wheel_separation>${wheel_separation}</wheel_separation>
                <wheel_radius>${wheel_radius}</wheel_radius>
                <odom_publish_frequency>1</odom_publish_frequency>
                <topic>/cmd_vel</topic>
            </plugin>
        </model>


        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>